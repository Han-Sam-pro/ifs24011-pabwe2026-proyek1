# Port frontend saat development / preview
APP_PORT=3000

# Alamat backend saat development (dipakai proxy Vite untuk /api)
API_PROXY_TARGET=http://localhost:3001

# Alamat API backend saat PRODUKSI (frontend & backend di host berbeda).
# Kosongkan jika frontend dan backend berada di domain yang sama (default: /api).
# Contoh: VITE_API_BASE_URL=https://api.roamplan.example.com/api
VITE_API_BASE_URL=

# Google Maps API key (opsional, ada fallback di kode)
VITE_GOOGLE_MAPS_API_KEY=
